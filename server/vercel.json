{
  "version": 2,
  "functions": {
    "index.js": {
      "maxDuration": 300
    }
  },
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["skills/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "index.js" }
  ]
}
